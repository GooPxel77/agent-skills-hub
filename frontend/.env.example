# Local development API
VITE_API_BASE_URL=http://localhost:8000

# Production Pages: leave API base empty to use published catalog JSON.
# Optional live catalog: set CATALOG_API_BASE_URL repository variable to your Worker origin.
# VITE_API_BASE_URL=https://catalog.example.com

# Browser credentials are only needed for Auth, favorites and existing community/admin actions.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Node-only build exporter; never use a VITE_ prefix for the service role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-key
# CATALOG_REUSE_SNAPSHOT=1
